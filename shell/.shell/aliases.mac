# Shell-independent aliases for mac

# Brew
alias brew-insecure='HOMEBREW_CASK_OPTS="--appdir=/Applications --fontdir=/Library/Fonts" brew $@'

# History
alias history-search='history 0 | fzf --tac'

# Colorize bsd ls
alias ls='ls -G'

# Gotos
alias goto-icons='cd /System/Library/CoreServices/CoreTypes.bundle/Contents/Resources'

# Cleanup
alias cleanup-brew='brew cleanup --prune 0'
alias cleanup-history='
    rm -rvf ~/.bash_history;
    rm -rvf ~/.lesshst;
    rm -rvf ~/.node_repl_history;
    rm -rvf ~/.viminfo;
    rm -rvf ~/.zsh_history;
    sqlite3 ~/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV* "delete from LSQuarantineEvent";
'
alias cleanup-logs='
    rm -rvf ~/.docker/application-template/logs/com.docker.log;
    rm -rvf ~/Library/Logs/*;
    rm -rvf /Library/Logs/DiagnosticReports/*;
'
alias cleanup-caches='
    rm -rvf ~/.ansible/tmp/
    rm -rvf ~/.zcompcache/
    rm -rvf ~/.npm/
    rm -rvf ~/Library/Caches/*
'
cleanup-python () {
    find . -type f -name "*.py[co]" -exec trash {} \;
    find . -type d -name "__pycache__" -exec trash {} \;
}

cleanup-node () {
    find . -name node_modules -type d -prune -exec trash {} +
}

# GPG
alias restart-gpg-agent='gpgconf --kill gpg-agent'

# Use  
alias youtube-dl='yt-dlp'

# Kubernetes
alias k='kubectl'
alias kp='kubectl get pods'
k-image() { 
    k get "deploy/$1" -o json | jq ".spec.template.spec.containers[0].image"
}

# Doctl
alias doctl-switch-0x41='doctl auth switch --context 0x41'
alias doctl-switch-work='doctl auth switch --context work'

# Chrome
alias insecure-chrome='/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --disable-web-security --user-data-dir="$HOME/Library/Application Support/Google/ChromeInsecure"'

# Youtube DL
alias youtube-dl-audio='yt-dlp --quiet --extract-audio --audio-format mp3 --audio-quality 0 -o "%(title)s.%(ext)s"'

# Claude
cl() {                                                             
    local branch ticket                                              
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)            
    ticket=$(echo "$branch" | grep -oiE '[a-z]+-[0-9]+' | head -1 |  tr '[:lower:]' '[:upper:]')                                        
    if [[ -n "$ticket" ]]; then                                      
      claude -n "$ticket" "$@"                                       
    else                                                             
      claude "$@"                                                    
    fi                                                               
}   

# 1Password
alias op-switch-0x41='op account use --account my.1password.eu'
alias op-switch-work='op account use --account eturnity.1password.eu'

